{
  "name": "ethereum-transactions-crawler",
  "version": "1.0.0",
  "description": "A web application that displays ethereum transactions from a certain wallet in a certain block",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "docker:build": "docker build -t ethereum-crawler .",
    "docker:run": "docker run -p 3000:3000 -e ALCHEMY_API_KEY=your_key ethereum-crawler"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NikolaLjepava"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "transactions",
    "wallet"
  ],
  "author": "Nikola Ljepava",
  "license": "ISC",
  "dependencies": {
    "alchemy-sdk": "^3.6.5",
    "axios": "^1.13.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  }
}
